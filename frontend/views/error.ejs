<% layout("/layouts/boilerplate.ejs") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg border-0 text-center">
        <div class="card-body p-5">
          <div class="mb-4">
            <i class="fa-solid fa-triangle-exclamation fa-4x text-danger"></i>
          </div>

          <h1 class="fw-bold text-danger mb-3">Oops! Something went wrong</h1>

          <p class="text-muted fs-5 mb-4"><%= message %></p>

          <a href="/listings" class="btn btn-dark px-4 py-2">
            <i class="fa-solid fa-house me-2"></i>
            Back to Listings
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
